# ==============================================================
# Unity 工程 .gitignore  (Unity 6 / 6000.x)
# ==============================================================

# --- Unity 生成的缓存与中间产物（绝对不要入库）---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity3D 生成的元数据文件（由 Unity 自行重建）
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# --- 自动生成的工程文件 ---
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vscode/
*.DotSettings.user

# --- 构建产物 ---
*.apk
*.aab
*.unitypackage
*.app
/[Ee]xported[Oo]bj/
/[Aa]ssets/[Aa]sset[Bb]undles/

# --- 崩溃与性能报告 ---
sysinfo.txt
crashlytics-build.properties
/[Aa]ssets/[Ss]treaming[Aa]ssets/.*

# --- 操作系统垃圾文件 ---
.DS_Store
Thumbs.db
desktop.ini
*~

# ==============================================================
# MCP 本地包：不随仓库分发
# 说明：该包实际放在 D:\GameProject\MCP\mcp-unity，
#       通过 Packages/manifest.json 的 file: 路径引用。
#       下面两条是保险：万一有人把包拷回工程里，也不会被提交。
# ==============================================================
/Packages/com.gamelovers.mcp-unity/
/[Aa]ssets/**/Server~/
node_modules/

# MCP 桥接令牌（每次启动重新生成）
/[Ll]ibrary/McpUnity/
